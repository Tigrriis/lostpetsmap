# Copy to .env for local development. Nothing here is required to run the app —
# with an empty file you get SQLite, no geocoding, and emails printed to the log.

# Sign session cookies and password-reset tokens. Any random string locally;
# Render generates one in production. Changing it logs everyone out and
# invalidates outstanding reset links.
SECRET_KEY=dev-insecure-change-me

# Postgres in production. Omit for a local SQLite file at instance/petmap.db.
# DATABASE_URL=postgresql://user:pass@localhost:5432/petmap

# Optional: enables the "find an address" box on the report form. The map pin
# works without it.
# GOOGLE_MAPS_API_KEY=

# Optional: real email delivery. Without a key, password-reset links and
# sighting alerts are written to the server log instead — which is how you
# test the reset flow locally.
# RESEND_API_KEY=
# MAIL_FROM=PetMap Tasmania <alerts@yourdomain.example>

# Set to 1 only behind HTTPS; it stops the session cookie working on
# http://localhost.
# SESSION_COOKIE_SECURE=0

SITE_NAME=PetMap Tasmania
